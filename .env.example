# Porta do servidor
PORT=3000

# URL do feed RSS (padrão: g1)
FEED_URL=https://g1.globo.com/rss/g1/

# Tempo de cache em segundos
CACHE_TTL=300

# Opcional: salva o último feed em um bucket S3 (deixe vazio para desativar).
# Na AWS, use um perfil IAM na instância em vez de chaves de acesso.
S3_BUCKET=
AWS_REGION=sa-east-1
